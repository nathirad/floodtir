{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hash-index data source lineage record",
  "type": "object",
  "required": [
    "data_source_hash_sha256",
    "source_id",
    "source_kind",
    "source_url",
    "provenance_status",
    "used_by_hash_datasets"
  ],
  "properties": {
    "data_source_hash_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "local_file_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "used_by_hash_datasets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
